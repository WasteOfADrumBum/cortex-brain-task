# Planner ("At a glance") settings. Copy to .env.local for local testing, and set
# the same three values in Vercel: Project cortex-brain > Settings > Environment Variables.
# Never commit real values.

# Todoist API token: Todoist > Settings > Integrations > Developer > API token.
TODOIST_TOKEN=

# Google Calendar "Secret address in iCal format" for each calendar, comma-separated.
# Find it in Google Calendar > the calendar's Settings > Integrate calendar.
# Anyone with one of these URLs can read that calendar, so keep them private.
GCAL_ICS_URLS=

# Any long random string (for example from `openssl rand -hex 32`).
# The planner page asks for it once per device and sends it with each API call.
# Without it both API routes answer 401.
DASH_KEY=
